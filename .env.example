# Copy to ".env" in this folder (gitignored). Values here load automatically when you run python3 server.py
# Do not commit .env — it may contain secrets.

LIBRETRANSLATE_BASE_URL=https://libretranslate.com
# Optional: only if your LibreTranslate host requires it (some hosted tiers).
# LIBRETRANSLATE_API_KEY=

# Required for شعارات وعلامات تجارية (API Ninjas logos).
API_NINJAS_API_KEY=

# Optional: only if The Trivia API returns 401/403 for your network.
# THE_TRIVIA_API_KEY=
